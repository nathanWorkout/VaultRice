QWidget {
    color: #d3c6aa;
}

QMainWindow,
QDialog {
    background-color: #2d353b;
}

DolphinView,
KItemListContainer,
KItemListContainerViewport,
QGraphicsView,
QGraphicsView::viewport,
QAbstractScrollArea::viewport,
QWidget#qt_scrollarea_viewport,
QAbstractScrollArea QWidget {
    background-color: #2d353b;
    background: #2d353b;
    color: #d3c6aa;
}

QToolBar,
QMenuBar,
QStatusBar {
    background-color: #343f44;
    color: #d3c6aa;
    border: 0;
    spacing: 4px;
}

QToolBar {
    padding: 4px;
}

QAbstractItemView,
QTreeView,
QListView,
QTableView {
    background-color: #2d353b;
    alternate-background-color: #343f44;
    color: #d3c6aa;
    selection-background-color: #a7c080;
    selection-color: #2d353b;
    border: 1px solid #343f44;
    outline: 0;
}

QHeaderView::section {
    background-color: #343f44;
    color: #d3c6aa;
    border: 0;
    border-right: 1px solid #343f44;
    border-bottom: 1px solid #343f44;
    padding: 6px 8px;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    background-color: #343f44;
    color: #d3c6aa;
    selection-background-color: #a7c080;
    selection-color: #2d353b;
    border: 1px solid #343f44;
    border-radius: 5px;
    padding: 5px 7px;
}

QPushButton,
QToolButton {
    background-color: #343f44;
    color: #d3c6aa;
    border: 1px solid #343f44;
    border-radius: 5px;
    padding: 5px 8px;
}

QPushButton:hover,
QToolButton:hover,
QMenu::item:selected,
QTabBar::tab:hover {
    background-color: #a7c080;
    color: #2d353b;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #a7c080;
    color: #2d353b;
}

QTabWidget::pane {
    background-color: #2d353b;
    border: 1px solid #343f44;
    top: -1px;
}

QTabBar::tab {
    background-color: #343f44;
    color: #d3c6aa;
    border: 1px solid #343f44;
    border-bottom: 0;
    padding: 7px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2d353b;
    color: #a7c080;
    border-bottom: 2px solid #a7c080;
}

QMenu {
    background-color: #343f44;
    color: #d3c6aa;
    border: 1px solid #343f44;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 3px;
}

QToolTip {
    background-color: #343f44;
    color: #d3c6aa;
    border: 1px solid #a7c080;
    padding: 4px 6px;
}

QScrollBar:vertical {
    width: 10px;
    background-color: #2d353b;
    margin: 2px;
}

QScrollBar:horizontal {
    height: 10px;
    background-color: #2d353b;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #343f44;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #a7c080;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QProgressBar {
    background-color: #343f44;
    color: #d3c6aa;
    border: 1px solid #343f44;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #a7c080;
    border-radius: 3px;
}
